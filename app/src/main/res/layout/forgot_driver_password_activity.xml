<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="26dp"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <!-- Driver Illustration -->
        <ImageView
            android:id="@+id/imgDriverReset"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:src="@drawable/ic_forgot_password"
            android:layout_marginTop="45dp"
            android:layout_marginBottom="18dp" />

        <TextView
            android:text="Driver Password Reset"
            android:textSize="23sp"
            android:textStyle="bold"
            android:textColor="#090505"
            android:layout_marginBottom="4dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <TextView
            android:text="Enter your registered email to receive reset link"
            android:textSize="14sp"
            android:textColor="#101112"
            android:layout_marginBottom="30dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <!-- Email Input Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/input_field"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/gmail" />

            <EditText
                android:id="@+id/etDriverEmail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@android:color/transparent"
                android:hint=" Email Address"
                android:padding="10dp"
                android:textColor="#0B0909"
                android:textColorHint="#0B0A0A" />
        </LinearLayout>

        <!-- Send Link Button -->
        <Button
            android:id="@+id/btnDriverResetLink"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="SEND RESET LINK"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1D89E4"
            android:layout_marginTop="22dp" />

        <!-- Back To Login -->
        <TextView
            android:id="@+id/tvDriverBackLogin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Back to Login"
            android:textSize="14sp"
            android:textColor="#140F0F"
            android:layout_marginTop="18dp" />

    </LinearLayout>

</ScrollView>
