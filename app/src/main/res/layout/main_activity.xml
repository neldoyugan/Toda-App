<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <!-- Decorative Teal Glow Circle (top-right) -->
    <View
        android:id="@+id/glowTop"
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:background="@drawable/glow_circle_teal"
        android:alpha="0.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_marginTop="-60dp"
        android:layout_marginEnd="-60dp" />

    <!-- Decorative Orange Glow (bottom-left) -->
    <View
        android:id="@+id/glowBottom"
        android:layout_width="180dp"
        android:layout_height="180dp"
        android:background="@drawable/glow_circle_orange"
        android:alpha="0.3"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_marginStart="-50dp"
        android:layout_marginBottom="-50dp" />

    <!-- Logo Badge -->
    <androidx.cardview.widget.CardView
        android:id="@+id/logoCard"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:layout_marginTop="120dp"
        app:cardCornerRadius="55dp"
        app:cardElevation="24dp"
        app:cardBackgroundColor="#00D4AA"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/centerImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="App Logo"
            android:scaleType="centerCrop"
            android:src="@drawable/toda1" />
    </androidx.cardview.widget.CardView>

    <!-- App Name + Tag -->
    <LinearLayout
        android:id="@+id/titleBlock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="18dp"
        app:layout_constraintTop_toBottomOf="@id/logoCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/appTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Maribojoc TODA"
            android:textColor="#FFFFFF"
            android:textSize="30sp"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:fontFamily="sans-serif-medium" />

        <TextView
            android:id="@+id/appTitleSub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="E - B O O K I N G"
            android:textColor="#00D4AA"
            android:textSize="12sp"
            android:letterSpacing="0.22"
            android:textStyle="bold" />

    </LinearLayout>

    <!-- Tagline -->
    <TextView
        android:id="@+id/appSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="40dp"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="40dp"
        android:gravity="center"
        android:text="Your premium tricycle ride, \nright at your fingertips 🛵"
        android:textColor="#8899BB"
        android:textSize="14sp"
        android:lineSpacingMultiplier="1.4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/titleBlock" />

    <!-- Feature Pills Row -->
    <LinearLayout
        android:id="@+id/pillsRow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/appSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="⚡ Fast"
            android:textColor="#00D4AA"
            android:textSize="12sp"
            android:background="@drawable/pill_teal"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🔒 Secure"
            android:textColor="#FF6B35"
            android:textSize="12sp"
            android:background="@drawable/pill_orange"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginEnd="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💳 Cashless"
            android:textColor="#8899BB"
            android:textSize="12sp"
            android:background="@drawable/pill_gray"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Get Started Button -->
    <Button
        android:id="@+id/btnTryNow"
        android:layout_width="0dp"
        android:layout_height="58dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:layout_marginBottom="80dp"
        android:background="@drawable/btn_get_started"
        android:text="Get Started →"
        android:textAllCaps="false"
        android:textColor="#0D1829"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.01"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Footer -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="28dp"
        android:text="© 2025 Maribojoc TODA E-Booking"
        android:textColor="#2E4066"
        android:textSize="11sp"
        app:layout_constraintBottom_toTopOf="@+id/btnTryNow"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
