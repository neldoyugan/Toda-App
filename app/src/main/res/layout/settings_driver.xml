<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal">

        <!-- Profile Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:padding="20dp"
            android:elevation="6dp"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="20dp">

            <ImageView
                android:id="@+id/driverProfileImage"
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:src="@drawable/person5"
                android:scaleType="centerCrop"
                android:clipToOutline="true"
                android:background="@drawable/profile_circle"
                android:padding="6dp" />

            <TextView
                android:id="@+id/driverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Driver Name"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#0B0808"
                android:layout_marginTop="12dp"
                android:fontFamily="sans-serif-medium"/>

            <TextView
                android:id="@+id/driverEmail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="driver@example.com"
                android:textSize="14sp"
                android:textColor="#0B0707"
                android:layout_marginTop="4dp"/>

            <TextView
                android:id="@+id/driverVehicleInfo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MOT-879"
                android:textSize="14sp"
                android:textColor="#101616"
                android:layout_marginTop="8dp"/>
        </LinearLayout>

        <!-- Options Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:elevation="6dp"
            android:padding="12dp">

            <!-- Edit Profile -->
            <LinearLayout
                android:id="@+id/optionDriverEditProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/card_background">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_edit_profile" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Edit Profile"
                    android:textColor="#070606"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#404040"/>

            <!-- Vehicle Settings -->
            <LinearLayout
                android:id="@+id/optionVehicleSettings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="@drawable/card_background">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/bookride" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Tricycle"
                    android:textColor="#033047"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#404040"/>

            <!-- Earnings -->
            <LinearLayout
                android:id="@+id/optionEarnings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_wallet" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Earnings"
                    android:textColor="#027802"
                    android:layout_marginStart="12dp"
                    android:textSize="16sp"/>
            </LinearLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#404040"/>

            <!-- Logout -->
            <LinearLayout
                android:id="@+id/driverLogout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="14dp"
                android:gravity="center_vertical"
                android:background="?android:attr/selectableItemBackground">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_logout"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logout"
                    android:textSize="16sp"
                    android:textColor="#FF5252"
                    android:layout_marginStart="12dp"/>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</ScrollView>
